# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# pixel-perfect PoC
/scripts/pixel-perfect/output/
.mcp.json

# claude
.claude/memory/
.claude/worktrees/

# agent / codex ローカル設定（個人環境用・共有しない）
.agents/
.codex/

# session-temporary（試運転用一時ファイル）
/.tmp-review/
/scripts/_*.ts

# 3D model backups (履歴用にローカル保持、リポジトリには含めない)
public/models/*.backup-*.glb
public/models/*.legacy.glb
public/models/*_legacy.glb

# Footer responsive check screenshots (確認用 PNG、不要)
/scripts/footer-*.png

# Supabase CLI 一時ファイル
supabase/.temp/
