# =============================================================
# お問い合わせフォーム送信（Resend）
# =============================================================
# 管理者宛通知 + 送信者宛自動返信の2通を Resend で送信する。
# 送信先・送信元アドレスはコード側 (src/app/api/contact/route.ts) で定義。
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxx

# =============================================================
# Supabase（ニュース管理画面）
# =============================================================
# プロジェクト: arigatosun-hp (Ref: xgvjgvhqmkuulupvvbnr)
# ダッシュボード: https://supabase.com/dashboard/project/xgvjgvhqmkuulupvvbnr/settings/api

# ── MCP / 管理 CLI 用（ローカル開発のみ） ──
# Personal Access Token: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxx
SUPABASE_PROJECT_REF=xgvjgvhqmkuulupvvbnr
SUPABASE_DB_PASSWORD=xxxxxxxxxxxxxxxx

# ── クライアント側（ブラウザ露出OK） ──
NEXT_PUBLIC_SUPABASE_URL=https://xgvjgvhqmkuulupvvbnr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxx

# ── サーバー側のみ（絶対に NEXT_PUBLIC_ を付けない / クライアント露出禁止） ──
# RLS をバイパスするため、Route Handler / Server Action からのみ参照
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxx

# =============================================================
# サイト URL（canonical / OGP / sitemap のベース）
# =============================================================
NEXT_PUBLIC_SITE_URL=https://arigatosun.com

# =============================================================
# アクセス解析（本番のみ設定。未設定ならタグは一切読み込まれない）
# =============================================================
# Google タグマネージャー のコンテナID（GTM-から始まる）。タグ運用はこれを軸とする。
NEXT_PUBLIC_GTM_ID=
# Google Analytics 4 の測定ID（G-から始まる）。GA4 は GTM 側で設定する方針のため通常は空のまま
# （直接設定すると GTM 内 GA4 と二重計測になる）。
NEXT_PUBLIC_GA_ID=
# Microsoft Clarity のプロジェクトID
NEXT_PUBLIC_CLARITY_ID=

# =============================================================
# AI コンポーズ（ニュース下書き生成 = Claude）
# =============================================================
# 管理画面「AIで作成」で本文・SEOメタを生成する。サーバー側 Server Action からのみ参照。
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# 使用モデル（任意。未設定なら claude-sonnet-4-6）
ANTHROPIC_MODEL=claude-sonnet-4-6

# =============================================================
# AI 画像生成（サムネ・本文画像 = Gemini 3 Pro Image / Nano Banana Pro）
# =============================================================
# 管理画面の画像生成で使用。サーバー側 Server Action からのみ参照。
GEMINI_API_KEY=xxxxxxxxxxxxxxxx
